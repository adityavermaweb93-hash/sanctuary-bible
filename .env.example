# Database (PostgreSQL)
# Example for local Postgres: postgresql://postgres:postgres@localhost:5432/bible_app?schema=public
# Example for Supabase/Neon: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bible_app?schema=public"

# Authentication & Security
JWT_SECRET="replace-with-a-secure-random-64-char-hex-string"
ENCRYPTION_KEY="replace-with-a-32-byte-hex-encryption-key-for-api-keys"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Licensed Bible API Providers (can also be configured in Admin Dashboard)
API_BIBLE_KEY=""
ESV_API_KEY=""

# Optional: Default AI Provider (can also be configured in Admin Dashboard)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
